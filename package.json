{
  "name": "@afilimax/shein-provider",
  "version": "0.1.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Afilimax/shein-provider.git"
  },
  "homepage": "https://github.com/Afilimax/shein-provider#readme",
  "bugs": {
    "url": "https://github.com/Afilimax/shein-provider/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:practical": "vitest run --config vitest.practical.config.mts",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "marcuth"
  ],
  "author": "Marcuth",
  "license": "MIT",
  "devDependencies": {
    "@afilimax/core": "^0.5.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "puppeteer": "^24.39.1",
    "puppeteer-core": "^24.39.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "peerDependencies": {
    "@afilimax/core": ">=0.5.0"
  }
}
